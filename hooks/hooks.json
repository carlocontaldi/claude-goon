{
  "description": "Resume sessions a usage limit interrupted",
  "modules": ["./register.ts"],
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/goon.py\""
          }
        ]
      }
    ]
  }
}
